CREATE DATABASE sistem_bonus_karyawan;

USE sistem_bonus_karyawan;

-- =====================================================
-- TABEL PENILAIAN KARYAWAN
-- =====================================================

CREATE TABLE penilaian_karyawan (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama_karyawan VARCHAR(100),

    hadir_bulan1 INT,
    hadir_bulan2 INT,
    hadir_bulan3 INT,
    hadir_bulan4 INT,
    hadir_bulan5 INT,
    hadir_bulan6 INT,

    total_hadir INT,
    status_absen VARCHAR(50),

    lembur VARCHAR(20),
    dinas_luar VARCHAR(20),
    masa_kerja VARCHAR(20),
    kinerja VARCHAR(50)
);

-- =====================================================
-- TABEL RULES
-- =====================================================

CREATE TABLE rules (
    id INT AUTO_INCREMENT PRIMARY KEY,
    hasil VARCHAR(20)
);

-- =====================================================
-- TABEL CONDITIONS
-- =====================================================

CREATE TABLE conditions (
    id INT AUTO_INCREMENT PRIMARY KEY,
    rule_id INT,
    parameter VARCHAR(50),
    nilai VARCHAR(50)
);

-- =====================================================
-- TABEL HASIL BONUS
-- =====================================================

CREATE TABLE hasil_bonus (
    id INT AUTO_INCREMENT PRIMARY KEY,
    nama_karyawan VARCHAR(100),
    hasil_bonus VARCHAR(20),
    rule_digunakan INT
);

